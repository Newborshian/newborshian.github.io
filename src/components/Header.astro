---
import { cv } from '../data/cv';
---

<header class="header">
  <div class="container">
    <p class="eyebrow">{cv.focus.join(' · ')}</p>
    <h1 class="name">{cv.name}</h1>
    <p class="headline">{cv.headline}</p>
    <div class="bio">
      {cv.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <ul class="contact" aria-label="Contact">
      <li><a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></li>
      <li><a href={cv.contact.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={cv.contact.github} rel="me noopener">GitHub</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    padding-block: var(--space-16) var(--space-12);
  }

  .eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .name {
    font-size: var(--text-3xl);
    margin-top: var(--space-2);
  }

  .headline {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .bio {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    font-size: var(--text-lg);
    max-width: 44rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
    font-weight: var(--weight-semibold);
  }
</style>
