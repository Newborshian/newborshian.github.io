---
import type { Experience } from '../data/cv';
import { formatMonth } from '../lib';

interface Props {
  experience: Experience;
}

const { experience: xp } = Astro.props;
---

<article class="card">
  <header>
    <h3 class="title">{xp.title}</h3>
    <p class="meta">
      <span>{xp.internal ? 'Projet interne : ' : 'Client : '}</span><span class="company">{xp.client}</span>
      <span aria-hidden="true"> · </span>
      <span>{xp.location}</span>
    </p>
    <p class="meta">
      <time datetime={xp.start}>{formatMonth(xp.start)}</time> – {
        xp.end ? <time datetime={xp.end}>{formatMonth(xp.end)}</time> : "aujourd'hui"
      }
    </p>
  </header>

  <p class="summary">{xp.summary}</p>

  {
    xp.results && (
      <>
        <h4 class="subtitle">Résultats</h4>
        <ul class="list">
          {xp.results.map((item) => <li>{item}</li>)}
        </ul>
      </>
    )
  }

  {
    xp.activities && (
      <details class="details">
        <summary>Rôles et activités</summary>
        <ul class="list">
          {xp.activities.map((item) => <li>{item}</li>)}
        </ul>
      </details>
    )
  }

  {
    xp.domain && (
      <>
        <h4 class="subtitle">Environnement fonctionnel</h4>
        <ul class="list">
          {xp.domain.map((item) => <li>{item}</li>)}
        </ul>
      </>
    )
  }

  <h4 class="visually-hidden">Environnement technique</h4>
  <ul class="tag-list stack">
    {xp.stack.map((item) => <li class="tag">{item}</li>)}
  </ul>
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .title {
    font-size: var(--text-xl);
  }

  .meta {
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .company {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .subtitle {
    font-size: var(--text-base);
    margin-bottom: calc(-1 * var(--space-2));
  }

  .list {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-6);
  }

  .details summary {
    cursor: pointer;
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    padding-block: var(--space-1);
  }

  .details[open] summary {
    margin-bottom: var(--space-3);
  }

  .stack {
    margin-top: var(--space-2);
  }
</style>
