---
// Assistant « pose une question sur mon parcours ».
// Masqué tant que JavaScript n'est pas actif : le site reste complet sans lui.
---

<section class="section no-print" id="assistant" aria-labelledby="assistant-titre" hidden>
  <div class="container">
    <h2 id="assistant-titre" class="section-title">Une question sur mon parcours ?</h2>
    <p class="intro">
      Cet assistant répond à partir du contenu de ce CV, grâce à l'API Claude. Il peut se tromper : pour toute décision,
      contactez-moi directement.
    </p>
    <form class="form" data-assistant-form>
      <label for="assistant-question">Votre question</label>
      <div class="row">
        <input
          id="assistant-question"
          name="question"
          type="text"
          required
          maxlength="500"
          autocomplete="off"
          placeholder="Par exemple : quelle expérience en CI/CD ?"
        />
        <button type="submit">Envoyer</button>
      </div>
    </form>
    <p class="answer" data-assistant-answer aria-live="polite"></p>
  </div>
</section>

<script>
  const section = document.getElementById('assistant');
  const form = document.querySelector<HTMLFormElement>('[data-assistant-form]');
  const output = document.querySelector<HTMLElement>('[data-assistant-answer]');

  if (section && form && output) {
    section.hidden = false;
    const button = form.querySelector('button')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = String(new FormData(form).get('question') ?? '').trim();
      if (!question) return;

      button.disabled = true;
      output.textContent = 'Réponse en cours…';
      try {
        const response = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question }),
        });
        const data = (await response.json()) as { answer?: string; error?: string };
        // textContent uniquement : la réponse n'est jamais interprétée comme du HTML.
        output.textContent = data.answer ?? data.error ?? 'Réponse indisponible.';
      } catch {
        output.textContent = "L'assistant est indisponible pour le moment.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .intro {
    color: var(--color-text-muted);
    max-width: 44rem;
  }

  .form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  label {
    font-weight: var(--weight-semibold);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  input {
    flex: 1 1 16rem;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    font: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-text-muted);
    border-radius: var(--radius-sm);
  }

  button {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-6);
    font: inherit;
    font-weight: var(--weight-semibold);
    color: var(--color-bg);
    background: var(--color-accent);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  button:hover {
    background: var(--color-accent-strong);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .answer {
    margin-top: var(--space-6);
    max-width: 44rem;
    white-space: pre-line;
  }

  .answer:empty {
    display: none;
  }
</style>
